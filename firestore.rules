rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow read/write access to rooms collection
    match /rooms/{roomId} {
      // Anyone can read room data (for joining rooms)
      allow read: if true;
      
      // Anyone can create a room
      allow create: if true;
      
      // Only allow updates if the user is part of the game
      // For now, allow all updates for testing
      allow update: if true;
      
      // Allow delete for room cleanup
      allow delete: if true;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
