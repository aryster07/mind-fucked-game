rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write to game rooms
    match /rooms/{roomCode} {
      // Anyone can read rooms
      allow read: if true;
      // Only create with valid player data
      allow create: if request.resource.data.host != null;
      // Only host can update game state, anyone can leave
      allow update: if request.auth != null;
      // Only host can delete
      allow delete: if request.auth != null;
    }
    
    // Allow read/write to user data
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;
      // Users can only write their own data
      allow write: if request.auth != null;
    }
  }
}
